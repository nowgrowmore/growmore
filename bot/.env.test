# Safe local defaults for running the bot's test suite. Checked into git
# (see repo-root .gitignore: ".env.test" is explicitly un-ignored).
#
# Real secrets (Dhan credentials, the Neon DATABASE_URL) NEVER go here -- they
# live only in the gitignored repo-root .env.local. This file only exists so
# unit tests that construct Settings() have harmless values to read, and so
# integration tests know which local Postgres to try.

DHAN_CLIENT_ID=test-client-id
DHAN_ACCESS_TOKEN=test-access-token
DHAN_ENV=sandbox

# Integration tests connect here; they skip gracefully (not a hard failure)
# if nothing is listening. See bot/README.md for how to start one locally.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/growmore_test
