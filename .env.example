# Copy relevant variables into bot/.env.local or dashboard/.env.local as needed.
# Never commit real values — this file documents names only.

# Dhan API (bot/) — production key needed for real market data; sandbox only simulates order flow.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_ENV=sandbox # sandbox | production

# Shared Postgres (Neon in deployed environments, local/dockerized Postgres for dev+CI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growmore_test
