# Neon Postgres connection string. Never commit a real value — see .env.local
# (gitignored) for the real one, and .env.test.local for a real local/test DB.
DATABASE_URL=

# Only needed to run `pnpm test:e2e:preview` locally against a real deployed
# Vercel Preview URL (see playwright.preview.config.ts). From the Vercel
# project: Settings -> Deployment Protection -> Protection Bypass for
# Automation. Never commit a real value.
VERCEL_AUTOMATION_BYPASS_SECRET=
PREVIEW_BASE_URL=
