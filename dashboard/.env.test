# Checked-in safe default for local test/dev runs. Points at the same local
# Postgres the bot's integration tests use (schema/migrations owned by
# `bot/`, Alembic). This is NOT a real secret — it's a well-known local
# default. Real credentials (Neon, staging, etc.) go in the gitignored
# .env.test.local, which overrides this file and is never created by tooling
# automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growmore_test
